    classDef normal fill:#f7fafc,stroke:#718096,color:#102a43
    classDef application fill:#e8f4e8,stroke:#38834a,stroke-width:2px,color:#20532c
    class SHADOW,DLP,PII,GUARD,MONITOR,RED,RED_TEST,PENTEST security
