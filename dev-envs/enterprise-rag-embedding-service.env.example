# Copy to enterprise-rag-embedding-service.env for local Compose use.
# The real file is ignored by Git and must not contain committed credentials.
EMBEDDING_SERVICE_HOST=0.0.0.0
EMBEDDING_SERVICE_PORT=8081
EMBEDDING_SERVICE_LOG_LEVEL=INFO
EMBEDDING_SERVICE_MAX_BATCH_SIZE=32
EMBEDDING_SERVICE_MAX_TEXT_CHARACTERS=32000

# RustFS/S3 model-artifact access. Replace placeholders before starting.
S3_PROVIDER=rustfs
S3_ENDPOINT_URL=http://rustfs:9000
S3_ACCESS_KEY=REPLACEWITHLOCALACCESSKEY
S3_SECRET_KEY=replace-with-a-long-local-secret-key
S3_REGION=us-east-1
S3_ADDRESSING_STYLE=path
S3_VERIFY_TLS=false
S3_MAX_CONCURRENCY=4

# Model files are synchronized before ONNX startup.
EMBEDDINGS_MODEL_NAME=intfloat/multilingual-e5-small
EMBEDDINGS_REVISION=main
EMBEDDINGS_LOCAL_DIRECTORY=/models/embedding/intfloat/multilingual-e5-small
EMBEDDINGS_BUCKET=models
EMBEDDINGS_KEY_PREFIX=embeddings/intfloat/multilingual-e5-small
EMBEDDINGS_DIMENSION=384
EMBEDDINGS_SPARSE_MODEL_NAME=multilingual-e5-token-frequency-v1
EMBEDDINGS_ONNX_MODEL_FILE=onnx/model.onnx
EMBEDDINGS_TOKENIZER_FILE=tokenizer.json
