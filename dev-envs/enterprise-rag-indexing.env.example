# Copy to enterprise-rag-indexing.env and replace credential placeholders.
# This file is consumed only by the enterprise-rag-indexing Compose service.
S3_PROVIDER=rustfs
S3_ENDPOINT_URL=http://rustfs:9000
S3_ACCESS_KEY=REPLACEWITHLOCALACCESSKEY
S3_SECRET_KEY=replace-with-a-long-local-secret-key
S3_REGION=us-east-1
S3_ADDRESSING_STYLE=path
S3_VERIFY_TLS=false
S3_MAX_CONCURRENCY=4
S3_PROCESSING_BUCKET=documents-processing
S3_CLAIM_TTL_SECONDS=3600

# Default source bucket; the CLI --source-bucket option overrides it.
S3_SOURCE_BUCKET=documents

# Ephemeral per-document files. Kubernetes should mount emptyDir here.
INDEXING_WORK_DIRECTORY=/work/indexing

# Page-bounded character windows used by PDFChunkerV1.
PDF_CHUNK_SIZE=1200
PDF_CHUNK_OVERLAP=200

# Shared embedding API used to vectorize citation-ready chunks.
EMBEDDING_SERVICE_PROVIDER=httpx
EMBEDDING_SERVICE_URL=http://enterprise-rag-embedding-service:8081
EMBEDDING_SERVICE_API_PATH=/v1/embeddings
EMBEDDING_SERVICE_TIMEOUT_SECONDS=60
EMBEDDING_SERVICE_VERIFY_TLS=false
EMBEDDING_SERVICE_MAX_CONNECTIONS=4
EMBEDDING_SERVICE_MAX_KEEPALIVE_CONNECTIONS=4
EMBEDDING_SERVICE_MAX_BATCH_SIZE=32
EMBEDDING_SERVICE_MAX_TEXT_CHARACTERS=32000
EMBEDDING_SERVICE_EXPECTED_MODEL=intfloat/multilingual-e5-small
EMBEDDING_SERVICE_EXPECTED_DIMENSION=384
EMBEDDING_SERVICE_EXPECTED_SPARSE_MODEL=multilingual-e5-token-frequency-v1

# Vector capability provider and Qdrant implementation settings.
VECTOR_PROVIDER=qdrant
# Leave QDRANT_API_KEY empty only for local development.
QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION_NAME=enterprise_rag_chunks
QDRANT_DENSE_VECTOR_NAME=dense
QDRANT_SPARSE_VECTOR_NAME=sparse
QDRANT_VECTOR_SIZE=384
QDRANT_BATCH_SIZE=64
QDRANT_TIMEOUT_SECONDS=30
QDRANT_MAX_RETRIES=3
QDRANT_RETRY_BASE_SECONDS=0.25
QDRANT_CREATE_COLLECTION_IF_MISSING=true
