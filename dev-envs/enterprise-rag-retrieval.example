# HTTP API
QUERY_API_HOST=0.0.0.0
QUERY_API_PORT=8082
QUERY_API_LOG_LEVEL=INFO
QUERY_API_REQUEST_TIMEOUT_SECONDS=30
QUERY_API_MAX_QUESTION_CHARACTERS=4000

# Shared embedding service
EMBEDDING_SERVICE_URL=http://enterprise-rag-embedding-service:8081
EMBEDDING_SERVICE_API_PATH=/v1/embeddings
EMBEDDING_SERVICE_PROVIDER=httpx
EMBEDDING_SERVICE_TIMEOUT_SECONDS=60
EMBEDDING_SERVICE_VERIFY_TLS=true
EMBEDDING_SERVICE_MAX_CONNECTIONS=4
EMBEDDING_SERVICE_MAX_KEEPALIVE_CONNECTIONS=4
EMBEDDING_SERVICE_MAX_BATCH_SIZE=32
EMBEDDING_SERVICE_MAX_TEXT_CHARACTERS=32000
EMBEDDING_SERVICE_EXPECTED_MODEL=intfloat/multilingual-e5-small
EMBEDDING_SERVICE_EXPECTED_REVISION=main
EMBEDDING_SERVICE_EXPECTED_DIMENSION=384
EMBEDDING_SERVICE_EXPECTED_NORMALIZED=true
EMBEDDING_SERVICE_EXPECTED_SPARSE_MODEL=multilingual-e5-token-frequency-v1

# Qdrant vector store. Leave QDRANT_API_KEY empty only for unsecured local use.
QDRANT_PROVIDER=qdrant
QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=
QDRANT_COLLECTION_NAME=enterprise-rag-chunks
QDRANT_DENSE_VECTOR_NAME=dense
QDRANT_SPARSE_VECTOR_NAME=sparse
QDRANT_VECTOR_SIZE=384
QDRANT_TIMEOUT_SECONDS=10

# Retrieval limits
RAG_TOP_K=5
RAG_CANDIDATE_K=20
RAG_HYBRID_PREFETCH_LIMIT=20
RAG_SCORE_THRESHOLD=
RAG_MAX_CONTEXT_CHARACTERS=20000

# Local FlashRank reranking. The default model is downloaded into this cache at startup.
RERANKING_PROVIDER=flashrank
RERANKING_MODEL_NAME=ms-marco-TinyBERT-L-2-v2
RERANKING_CACHE_DIR=/tmp/flashrank
RERANKING_MAX_LENGTH=128
RERANKING_MAX_CONCURRENCY=1

# LLM_PROVIDER: openai_compatible, anthropic, or cohere.
# Set the matching provider API base URL/model. Never commit API keys.
LLM_PROVIDER=openai_compatible
LLM_BASE_URL=https://llm.example.invalid/v1
LLM_MODEL=replace-with-deployed-model
LLM_API_KEY=
LLM_SYSTEM_PROMPT=Answer using only the supplied context. If the context is insufficient, say so clearly.
LLM_TIMEOUT_SECONDS=30
LLM_VERIFY_TLS=true
LLM_MAX_CONNECTIONS=20
LLM_MAX_KEEPALIVE_CONNECTIONS=10
LLM_TEMPERATURE=
LLM_MAX_OUTPUT_TOKENS=1024
